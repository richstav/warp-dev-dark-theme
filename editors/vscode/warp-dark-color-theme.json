  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#808080",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "comment.doc"
      ],
      "settings": {
        "foreground": "#6e6e6e",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type"
      ],
      "settings": {
        "foreground": "#00c2ff"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#a5d5fe"
      }
    },
    {
      "scope": [
        "string",
        "string.unquoted",
        "string.quoted"
      ],
      "settings": {
        "foreground": "#b4fa72"
      }
    },
    {
      "scope": [
        "string.escape"
      ],
      "settings": {
        "foreground": "#e5e6fe"
      }
    },
    {
      "scope": [
        "number",
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#fefdc2"
      }
    },
    {
      "scope": [
        "constant",
        "constant.language"
      ],
      "settings": {
        "foreground": "#fefdc2"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "variable.readwrite"
      ],
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#ffc4bd",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "variable.member",
        "property",
        "property.object"
      ],
      "settings": {
        "foreground": "#c1e3fe"
      }
    },
    {
      "scope": [
        "function",
        "function.declaration",
        "function.method"
      ],
      "settings": {
        "foreground": "#d0d1fe"
      }
    },
    {
      "scope": [
        "support.function"
      ],
      "settings": {
        "foreground": "#d0d1fe"
      }
    },
    {
      "scope": [
        "type",
        "storage.type",
        "struct",
        "class"
      ],
      "settings": {
        "foreground": "#fefdc2"
      }
    },
    {
      "scope": [
        "type.interface"
      ],
      "settings": {
        "foreground": "#fefdc2",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "tag",
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#ff8272"
      }
    },
    {
      "scope": [
        "attribute.name"
      ],
      "settings": {
        "foreground": "#ff8ffd",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity",
        "entity.name"
      ],
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "scope": [
        "punctuation",
        "punctuation.definition"
      ],
      "settings": {
        "foreground": "#8e8e8e"
      }
    },
    {
      "scope": [
        "punctuation.bracket"
      ],
      "settings": {
        "foreground": "#8e8e8e"
      }
    },
    {
      "scope": [
        "punctuation.delimiter"
      ],
      "settings": {
        "foreground": "#6e6e6e"
      }
    },
    {
      "scope": [
        "operator"
      ],
      "settings": {
        "foreground": "#a5d5fe"
      }
    },
    {
      "scope": [
        "label"
      ],
      "settings": {
        "foreground": "#fefdc2"
      }
    },
    {
      "scope": [
        "namespace"
      ],
      "settings": {
        "foreground": "#d0d1fe"
      }
    },
    {
      "scope": [
        "regexp"
      ],
      "settings": {
        "foreground": "#e5e6fe"
      }
    },
    {
      "scope": [
        "emphasis"
      ],
      "settings": {
        "foreground": "#d0d1fe",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "emphasis.strong"
      ],
      "settings": {
        "foreground": "#ffffff",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#ff8272"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic"
      ],
      "settings": {
        "foreground": "#d0d1fe"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#fefdc2"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#ff8ffd"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#e5e6fe"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#00c2ff",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#b4fa72"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "function": "#d0d1fe",
    "method": "#d0d1fe",
    "class": "#fefdc2",
    "type": "#fefdc2",
    "interface": "#fefdc2",
    "enum": "#fefdc2",
    "namespace": "#d0d1fe",
    "parameter": "#ffc4bd",
    "property": "#c1e3fe",
    "variable": "#ffffff",
    "string": "#b4fa72",
    "number": "#fefdc2",
    "keyword": "#00c2ff",
    "comment": {
      "foreground": "#808080",
      "italic": true
    }
  }
}
